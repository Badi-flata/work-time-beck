// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum Role {
  SUPER_ADMIN // مدير النظام العام (له كامل الصلاحيات)
  EMPLOYEE    // الموظف العادي
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  EXCUSED
  ESCAPY
}

enum ExcuseType {
  IN    // عذر تأخر في الحضور
  OUT   // عذر خروج مبكر أو عدم انصراف
}

// ----------------------------------------------------
// Models
// ----------------------------------------------------

// جدول المستخدمين الرئيسي (لأغراض تسجيل الدخول والمصادقة)
model User {
  id           String           @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  jobTitle     String?       // المسمى الوظيفي
  imageProfile String?
  role         Role          @default(EMPLOYEE)
  phone        String?
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // علاقات الامتداد (1-to-1 العلاقات)
  employeeProfile EmployeeProfile? // يمتد هنا إذا كان موظفاً
  adminProfile    AdminProfile?    // يمتد هنا إذا كان مديراً
}

// جديد: جدول ملف المدير (مفصول تماماً عن تعقيدات الحضور)
model AdminProfile {
  id             String           @id @default(uuid())
  
  // ربطه بحساب المستخدم الرئيسي
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // العلاقات الإدارية:
  // المدير يدير أقساماً معينة
  managedDepartments Department[]
  
  // المدير يشرف على موظفين محددين بشكل مباشر (اختياري)
  subordinates       EmployeeProfile[]
}

// جدول ملف الموظف (مخصص لمتابعة العمل والحضور والورديات)
model EmployeeProfile {
  id         String           @id @default(uuid())
  
  // ربطه بحساب المستخدم الرئيسي
  userId         String          @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  isWorking        Boolean        @default(false)
  salary           Int            @default(500)
  salaryDeduction  Int            @default(0)

  // علاقات العمل الأساسية
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id])
  
  shiftId      String
  shift        Shift        @relation(fields: [shiftId], references: [id])

  // علاقة المدير المباشر: ربط الموظف بالمدير المسؤول عنه
  managerId    String?
  manager      AdminProfile? @relation(fields: [managerId], references: [id])

  // سجلات الحضور الخاصة بالموظف فقط
  attendances  Attendance[]
}

// جدول الأقسام
model Department {
  id             String            @id @default(uuid())
  name           String            @unique
  description    String?           // وصف القسم
  
  // العلاقات
  employees      EmployeeProfile[]
  shift          Shift[]
  
  // ربط القسم بالمدير المسؤول عنه
  managerId      String
  manager        AdminProfile?        @relation(fields: [managerId], references: [id])
}

// جدول الورديات
model Shift {
  id             String           @id @default(uuid())
  name           String            
  startTime      String            
  endTime        String            
  gracePeriodMinIn  Int               @default(15)
  gracePeriodMinOut Int               @default(30)

  departmentsId  String  
  departments    Department @relation(fields: [departmentsId], references: [id], onDelete: Cascade)

  employees      EmployeeProfile[]
}

// جدول الحضور والانصراف (مرتبط فقط بملف الموظف)
model Attendance {
  id                  String            @id @default(uuid())
  date                DateTime          @db.Date
  checkIn             DateTime? 
  excuseReasonIn        String?          @db.Text
  isExcusedIn           Boolean          @default(false)  

  checkOut            DateTime?   
  excuseReasonOut       String?          @db.Text
  isExcusedOut          Boolean          @default(false)       
  status              AttendanceStatus   @default(ON_TIME)
  
  delayMinutes        Int                @default(0)
  earlyLeaveMinutes   Int                @default(0)
  totalWorkedMinutes  Int                @default(0)
  adminNotes          String?            @db.Text
  employeeNote        String?            @db.Text  // ملاحظات الموظف عند الخروج

  // أعذار مرتبطة بهذا السجل
  excuses             Excuse[]

  // ارتباط السجل بالموظف
  employeeProfileId   String
  employeeProfile     EmployeeProfile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, date])
}

// نموذج الأعذار — لتسجيل أعذار الحضور والانصراف
model Excuse {
  id              String      @id @default(uuid())
  reason          String      @db.Text
  type            ExcuseType  // IN أو OUT
  isApproved      Boolean     @default(false)
  createdAt       DateTime    @default(now())

  // ارتباط بسجل الحضور
  attendanceId    String
  attendance      Attendance  @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  // من قدم العذر
  submittedById   String
}