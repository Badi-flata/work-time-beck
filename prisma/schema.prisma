// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum Role {
  SUPER_ADMIN // مدير النظام العام (له كامل الصلاحيات)
  MANAGER // مدير القسم (له صلاحيات الإدارة على الموظفين)
  EMPLOYEE    // الموظف العادي
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  EXCUSED
  ESCAPY
}

enum ExcuseType {
  ABSENT
  LATE    // عذر تأخر في الحضور
  EARLY_DEPARTURE   // عذر خروج مبكر أو عدم انصراف
}

// ----------------------------------------------------
// Models
// ----------------------------------------------------

// جدول المستخدمين الرئيسي (لأغراض تسجيل الدخول والمصادقة)
model User {
  id           String           @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  jobTitle     String?       // المسمى الوظيفي
  imageProfile String?
  role         Role          @default(EMPLOYEE)
  phone        String?
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // علاقات الامتداد (1-to-1 العلاقات)
  employeeProfile EmployeeProfile? // يمتد هنا إذا كان موظفاً
  adminProfile    AdminProfile?    // يمتد هنا إذا كان مديراً
  refreshSessions RefreshSession[] // جلسات التجديد
}

// جديد: جدول ملف المدير (مفصول تماماً عن تعقيدات الحضور)
model AdminProfile {
  id             String           @id @default(uuid())
  
  // ربطه بحساب المستخدم الرئيسي
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // تفضيلات الأتمتة والخصم القابلة للتخصيص
  autoCheckoutEnabled       Boolean @default(true)

  isActiveDeduction    Boolean @default(false) // تفعيل/تعطيل خصم الراتب اليومي بالكامل
  //  customizing deductions  
  combineDeductionsOnEndShift    Boolean @default(false) // تفعيل/تعطيل خصم الراتب اليومي بالكامل
  delayDeductionEnabled     Boolean @default(true) // تفعيل/تعطيل خصم التأخير عن الحضور
  earlyLeaveDeductionEnabled Boolean @default(true) // تفعيل/تعطيل خصم الخروج المبكر / الهروب
  absentDeductionEnabled    Boolean @default(true) // خصم التأخير فور انتهاء فترة السماح بدل نهاية اليوم

  // العلاقات الإدارية:
  // المدير يدير أقساماً معينة
  managedDepartments Department[]
  
  // المدير يشرف على موظفين محددين بشكل مباشر (اختياري)
  subordinates       EmployeeProfile[]

  @@index([userId, autoCheckoutEnabled])
}

// جدول تتبع جلسات الـ Refresh Tokens ومنع إعادة الاستخدام
model RefreshSession {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
}

// جدول ملف الموظف (مخصص لمتابعة العمل والحضور والورديات)
model EmployeeProfile {
  id         String           @id @default(uuid())
  
  // ربطه بحساب المستخدم الرئيسي
  userId         String          @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  isWorking        Boolean        @default(false)
  salary           Int            @default(500)


  // علاقات العمل الأساسية
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id])
  
  shiftId      String?
  shift        Shift?        @relation(fields: [shiftId], references: [id])

  // علاقة المدير المباشر: ربط الموظف بالمدير المسؤول عنه
  managerId    String?
  manager      AdminProfile? @relation(fields: [managerId], references: [id])

  // سجلات الحضور الخاصة بالموظف فقط
  attendances  Attendance[]

  @@index([managerId])
  @@index([userId])
  @@index([managerId, isWorking])
  @@index([departmentId, shiftId])
}

// جدول الأقسام
model Department {
  id                      String            @id @default(uuid())
  name                    String            @unique
  description             String?           // وصف القسم
  
  // القواعد والتهيئة التشغيلية للقسم
  monthlyWorkingDays      Int               @default(22)
  weekendDays             Int[]             @default([5, 6])
  monthlyHolidays         Int               @default(0)
  latePenaltyAmount       Float             @default(50.0)
  earlyLeavePenaltyAmount Float             @default(50.0)
  absentPenaltyAmount     Float             @default(100.0)

  // العلاقات
  employees               EmployeeProfile[]
  shift                   Shift[]
  
  // ربط القسم بالمدير المسؤول عنه
  managerId               String
  manager                 AdminProfile?     @relation(fields: [managerId], references: [id])
}

// جدول الورديات
model Shift {
  id                String           @id @default(uuid())
  managerName       String?
  name              String            
  startTime         String            
  endTime           String            
  gracePeriodMinIn  Int               @default(15)
  gracePeriodMinOut Int               @default(30)

  departmentsId     String  
  departments       Department @relation(fields: [departmentsId], references: [id], onDelete: Cascade)

  employees         EmployeeProfile[]
}

// جدول الحضور والانصراف (مرتبط فقط بملف الموظف)
model Attendance {
  id                  String            @id @default(uuid())
  date                DateTime          @db.Date
  checkIn             DateTime? 
  checkOut            DateTime?      
  status              AttendanceStatus   @default(ON_TIME)
  
  managerName         String?
  departmentName      String?

  shiftId             String?
  shiftName           String?
  shiftStart          String?            
  shiftEnd            String?            
  graceIn             Int               @default(15)
  graceOut            Int               @default(30)
  
  salaryDeduction     Int               @default(0)
  deductionsCount     Int               @default(0)
  deductionBreakdown  Json?
  delayMinutes        Int               @default(0)
  earlyLeaveMinutes   Int               @default(0)
  lateMinutes         Int               @default(0)
  totalWorkedHours    Float             @default(0)
  adminNotes          String?           @db.Text
  employeeNote        String?           @db.Text  // ملاحظات الموظف عند الخروج

  // أعذار مرتبطة بهذا السجل
  excuses             Excuse[]

  // ارتباط السجل بالموظف
  employeeProfileId   String
  employeeProfile     EmployeeProfile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, date])
  @@index([date])
  @@index([employeeProfileId, date])
  @@index([date, status])
}

// نموذج الأعذار — لتسجيل أعذار الحضور والانصراف
model Excuse {
  id              String      @id @default(uuid())
  reason          String      @db.Text
  type            ExcuseType  // IN أو OUT
  isApproved      Boolean     @default(false)
  createdAt       DateTime    @default(now())

  // ارتباط بسجل الحضور
  attendanceId    String?
  attendance      Attendance?  @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  // من قدم العذر
  submittedById   String

  @@index([submittedById])
  @@index([attendanceId])
  @@index([submittedById, isApproved])
}